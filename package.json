{
  "name": "@nurkamol/leads-kit",
  "version": "0.7.0",
  "description": "Contact-form enquiries in Workers KV, read back safely — Cloudflare Access auth, audited delete, and CSV/JSON/XML/Mailchimp/Klaviyo exports. Framework-free.",
  "keywords": [
    "cloudflare",
    "workers",
    "kv",
    "leads",
    "contact-form",
    "cloudflare-access",
    "astro",
    "nextjs",
    "csv",
    "mailchimp",
    "klaviyo"
  ],
  "license": "MIT",
  "author": "Nurkamol Vakhidov <nurkamol@gmail.com>",
  "homepage": "https://github.com/nurkamol/leads-kit#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/nurkamol/leads-kit.git"
  },
  "bugs": "https://github.com/nurkamol/leads-kit/issues",
  "type": "module",
  "engines": {
    "node": ">=18"
  },
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/src/index.d.ts",
      "default": "./dist/src/index.js"
    },
    "./astro": {
      "types": "./dist/src/adapters/astro.d.ts",
      "default": "./dist/src/adapters/astro.js"
    },
    "./next": {
      "types": "./dist/src/adapters/next.d.ts",
      "default": "./dist/src/adapters/next.js"
    },
    "./worker": {
      "types": "./dist/src/adapters/worker.d.ts",
      "default": "./dist/src/adapters/worker.js"
    },
    "./package.json": "./package.json"
  },
  "bin": {
    "leads-kit": "./dist/cli/index.js"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "rm -rf dist && tsc",
    "test": "node --test test/*.test.js",
    "prepublishOnly": "npm run build && npm test",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "@types/node": "^22.20.1",
    "typescript": "^5.9.0"
  },
  "publishConfig": {
    "access": "public"
  }
}
